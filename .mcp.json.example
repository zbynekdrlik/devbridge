{
  "mcpServers": {
    "win-example-server": {
      "type": "http",
      "url": "http://YOUR_SERVER_IP:8090/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN_HERE"
      }
    },
    "win-example-client": {
      "type": "http",
      "url": "http://YOUR_CLIENT_IP:8090/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_TOKEN_HERE"
      }
    }
  }
}
